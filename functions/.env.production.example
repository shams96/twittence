# Copy to functions/.env on the VPS and fill in real values. Never commit the real .env.

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: enables the Google Lighthouse SEO score comparison. See functions/.env.example for how
# to get one. Leave unset to skip the comparison.
PAGESPEED_API_KEY=

NODE_ENV=production
PORT=3000

# REQUIRED off Firebase: this file also ships as-is with the Firebase Cloud Functions deploy, where
# this must stay unset (Cloud Functions invokes the exported handler directly and never calls
# listen() itself). Anywhere the app needs to run its own HTTP server — a VPS, Hostinger's Node.js
# hosting, local dev — set this to "true".
STANDALONE_SERVER=true

# Firebase project the app talks to for Auth + Firestore (unchanged from the Firebase deployment —
# this VPS only replaces where the Express server runs, not where auth/data live).
FIREBASE_PROJECT_ID=sound-octagon-444117-m9

# REQUIRED off Google Cloud: Cloud Functions gets credentials automatically; a VPS does not.
# Firebase Console > Project Settings > Service Accounts > Generate new private key, upload the
# JSON file to the VPS (outside the web root, e.g. /home/deploy/twittence-service-account.json,
# chmod 600), and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=/home/deploy/twittence-service-account.json

# Comma-separated. Must include your real domain(s) or the browser's CORS preflight will fail.
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

# Optional but recommended for a VPS/shared-hosting deployment: a shared-hosting IP's bot reputation
# with services like Cloudflare is often worse than Google Cloud's — confirmed live, a real site's
# Cloudflare rate limiting blocked Hostinger's IP while Google's own infrastructure fetched the same
# page successfully. When set, a failed direct page fetch falls back to routing through the Firebase
# Cloud Function's IP instead. Must match INTERNAL_FETCH_SECRET set on the Firebase deployment's
# functions/.env (the Firebase side never needs FETCH_PROXY_URL itself — it's only ever the target).
INTERNAL_FETCH_SECRET=
FETCH_PROXY_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net

# Optional: live citation tracking (Google AI Overview / ChatGPT visibility) — hybrid BYOK + paid
# credits feature. Everything is inert (returns 503/graceful "not configured" messages) until these
# are set. See functions/index.js's "/api/citation-*" and "/api/credits/*" routes.
#
# The "bring your own key" path needs no server config at all: the key never touches this server's
# storage. It lives in the user's browser (sessionStorage, cleared when they close the tab) and is
# sent with each check request for one-time in-memory use only.

# Optional: Twittence's own DataForSEO account (login/password pair, not a single key), used only for
# the "managed credits" path — i.e. only spent when a signed-in user has purchased and has remaining
# credits. Users with their own BYOK key never touch this account.
CITATION_PROVIDER_LOGIN=
CITATION_PROVIDER_PASSWORD=

# Optional: Stripe, for selling citation-check credit packs. Get these from the Stripe Dashboard >
# Developers > API keys, and > Webhooks (after pointing a webhook at
# https://YOUR_DOMAIN/api/webhooks/stripe for the checkout.session.completed event).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CREDIT_PACK_PRICE_USD=9
CREDIT_PACK_SIZE=10

STRIPE_PRICE_FOUNDING=
STRIPE_PRICE_STANDARD=
FOUNDING_CAP=100

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
