# Copy to functions/.env on the VPS and fill in real values. Never commit the real .env.

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: enables the Google Lighthouse SEO score comparison. See functions/.env.example for how
# to get one. Leave unset to skip the comparison.
PAGESPEED_API_KEY=

NODE_ENV=production
PORT=3000

# REQUIRED off Firebase: this file also ships as-is with the Firebase Cloud Functions deploy, where
# this must stay unset (Cloud Functions invokes the exported handler directly and never calls
# listen() itself). Anywhere the app needs to run its own HTTP server — a VPS, Hostinger's Node.js
# hosting, local dev — set this to "true".
STANDALONE_SERVER=true

# Firebase project the app talks to for Auth + Firestore (unchanged from the Firebase deployment —
# this VPS only replaces where the Express server runs, not where auth/data live).
FIREBASE_PROJECT_ID=sound-octagon-444117-m9

# REQUIRED off Google Cloud: Cloud Functions gets credentials automatically; a VPS does not.
# Firebase Console > Project Settings > Service Accounts > Generate new private key, upload the
# JSON file to the VPS (outside the web root, e.g. /home/deploy/twittence-service-account.json,
# chmod 600), and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=/home/deploy/twittence-service-account.json

# Comma-separated. Must include your real domain(s) or the browser's CORS preflight will fail.
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN
